# Copy of the keys `pnpm setup:local` writes to n8n/.env (gitignored, mode 0600).
# Do not fill this file in: run `pnpm setup:local`, which generates the secrets.

# 32 random bytes (hex). Encrypts n8n credentials at rest; losing it makes them unreadable.
N8N_ENCRYPTION_KEY=
# 32 random bytes (hex). Password of the n8n Postgres user.
POSTGRES_PASSWORD=
# 32 random bytes (hex). Convex -> n8n signatures; Convex holds it as N8N_WEBHOOK_SECRET.
LENDLOOP_N8N_WEBHOOK_SECRET=
# 32 random bytes (hex). n8n -> Convex signatures; Convex holds it as CONVEX_INBOUND_SECRET.
LENDLOOP_CONVEX_INBOUND_SECRET=
# Only after `pnpm setup:local --rotate`: the previous values, still accepted by their
# verifiers (n8n for the webhook secret, Convex for the inbound one) so a rotation drops nothing.
LENDLOOP_N8N_WEBHOOK_SECRET_PREVIOUS=
LENDLOOP_CONVEX_INBOUND_SECRET_PREVIOUS=
# 24 random bytes (base64url). Password of the n8n owner account; never passed to the container.
N8N_OWNER_PASSWORD=
# bcrypt (cost 10) of N8N_OWNER_PASSWORD, with "$" doubled for docker compose.
N8N_INSTANCE_OWNER_PASSWORD_HASH=
# n8n owner account, provisioned from env (the instance can never be claimed by someone else).
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_FIRST_NAME=
N8N_INSTANCE_OWNER_LAST_NAME=
# IANA zone for the reminder schedule; Convex APP_TIMEZONE is set to the same value.
GENERIC_TIMEZONE=
# Convex HTTP actions URL as seen from inside the n8n container.
CONVEX_SITE_URL=
# Sender of every LendLoop email, for example: LendLoop <no-reply@example.com>
MAIL_FROM=
# Receives the last-resort alert when Convex cannot be reached from the error workflow.
OPS_EMAIL=
# Email API n8n posts to (Resend's request format): http://mail-api:8080 locally (the
# stand-in that relays to Mailpit), https://api.resend.com in production.
MAIL_API_URL=
# 32 random bytes (hex) locally; a sending-only Resend API key in production.
MAIL_API_KEY=
# Host port for the Mailpit web UI and API (8025 unless already taken on this machine).
MAILPIT_UI_PORT=
