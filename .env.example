# Next.js (filled by `convex dev` for local; Vercel env in production)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_DEPLOYMENT=

# Clerk: Dashboard → API keys. Never commit the secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex deployment env vars are set with `npx convex env set NAME value`, not here:
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   APP_TIMEZONE              IANA zone used for "today" and overdue (default UTC)
#   APP_URL                   (Plan 2) public app URL used in email links
